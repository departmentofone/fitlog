{
  "name": "fitlog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --mode native && node scripts/pack-web-update.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ds": "vite build --config design-system/vite.config.ts && tsc -p design-system/tsconfig.json",
    "check:app-links": "node scripts/check-app-links.mjs",
    "build:web": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native && cap sync android",
    "android:debug": "npm run build:native && node scripts/android.mjs debug",
    "android:release": "npm run build:native && node scripts/android.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-updater": "^8.52.1",
    "@capgo/native-purchases": "^8.8.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@vercel/functions": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "fitlogNative": {
    "versionCode": 100,
    "versionName": "2.0.0",
    "minVersionCodeForWebUpdates": 100
  }
}
